#!/bin/bash
# Installs the self-contained REAPI development environment. OpenTofu embeds
# the pinned flake and delivers later updates through an SSM association.
set -euxo pipefail

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y curl git nix-bin nix-setup-systemd openssh-server xz-utils

# Session Manager normally creates this account on first login. Creating it
# here gives SSM and optional editor SSH one stable home directory.
if ! id -u ssm-user >/dev/null 2>&1; then
  useradd -m -s /bin/bash ssm-user
fi
usermod -s /bin/bash ssm-user
install -d -m 0755 /etc/sudoers.d
cat > /etc/sudoers.d/ssm-agent-users <<'EOF'
# User rules for ssm-user
ssm-user ALL=(ALL) NOPASSWD:ALL
EOF
chmod 0440 /etc/sudoers.d/ssm-agent-users

install -d -m 0755 /etc/nix /opt/reapi-dev

cat > /etc/nix/nix.conf <<'EOF'
experimental-features = nix-command flakes
sandbox = true
trusted-users = root ssm-user
EOF

# Repair clients where SSM has already created its session user. On a fresh
# client the reapi-dev wrapper below performs this once after the first login.
usermod -aG nix-users ssm-user

printf '%s' '${flake_nix_b64}' | base64 -d > /opt/reapi-dev/flake.nix
printf '%s' '${flake_lock_b64}' | base64 -d > /opt/reapi-dev/flake.lock
chmod 0644 /opt/reapi-dev/flake.nix /opt/reapi-dev/flake.lock

cat > /etc/profile.d/reapi-farm.sh <<'EOF'
export REAPI_ENDPOINT="grpc://${farm_private_ip}:50051"
EOF
chmod 0644 /etc/profile.d/reapi-farm.sh

cat > /usr/local/bin/reapi-dev <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
export REAPI_ENDPOINT="grpc://${farm_private_ip}:50051"

# Ubuntu restricts the Nix daemon socket to nix-users. SSM creates ssm-user
# only when its first session starts, so enter that group at runtime.
case " $(id -nG) " in
  *" nix-users "*) ;;
  *)
    current_user="$(id -un)"
    sudo -n /usr/sbin/usermod -aG nix-users "$current_user"
    exec sudo -n -u "$current_user" "$0" "$@"
    ;;
esac

exec nix --extra-experimental-features 'nix-command flakes' develop path:/opt/reapi-dev "$@"
EOF
chmod 0755 /usr/local/bin/reapi-dev

install -d -m 0755 /etc/ssh/sshd_config.d
cat > /etc/ssh/sshd_config.d/00-rig.conf <<'EOF'
ListenAddress 127.0.0.1
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
PermitRootLogin no
PubkeyAuthentication yes
AllowUsers ssm-user
EOF

# Interactive editor terminals enter the same pinned environment as ./rig shell.
touch /home/ssm-user/.bashrc
if ! grep -qF '# sccache-rig development shell' /home/ssm-user/.bashrc; then
  cat >> /home/ssm-user/.bashrc <<'EOF'

# sccache-rig development shell
if [[ $- == *i* && -z $${IN_NIX_SHELL:-} ]]; then
  exec /usr/local/bin/reapi-dev
fi
EOF
fi
chown ssm-user:ssm-user /home/ssm-user/.bashrc

install -d -m 0755 /run/sshd
sshd -t
systemctl unmask ssh.socket 2>/dev/null || true
systemctl disable --now ssh.socket 2>/dev/null || true
rm -f /etc/systemd/system/ssh.service.requires/ssh.socket
systemctl mask ssh.socket
systemctl daemon-reload
systemctl enable --now ssh.service
systemctl enable --now nix-daemon.service
